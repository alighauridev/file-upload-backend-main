# ---- Development (Docker): npm run db:up ----
NODE_ENV=development
PORT=5001
DATABASE_URL=postgres://file_upload:file_upload_dev@localhost:5435/file_upload
LOCAL_STORAGE_URL=http://localhost:9000
LOCAL_STORAGE_TOKEN=file_upload_dev_storage
LOCAL_STORAGE_BUCKET_NAME=file-upload

ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRE=30d
REFRESH_TOKEN_SECRET=change-me
REFRESH_TOKEN_EXPIRE=30d
USER_STORAGE_LIMIT=100MB
TRASH_RETENTION_DAYS=30

# ---- Production (Render): NODE_ENV=production is set by `npm start`; Supabase replaces Docker ----
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=<key>
# SUPABASE_BUCKET_NAME=avatars
